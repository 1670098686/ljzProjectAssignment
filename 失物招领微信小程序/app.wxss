/**app.wxss**/
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

/* ================= 通用容器 ================= */
.container {
  padding: 20rpx;
}

.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-sm {
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* ================= 通用按钮 ================= */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  font-size: 32rpx;
  text-align: center;
}

.btn-primary {
  background: linear-gradient(135deg, #1890FF 0%, #096dd9 100%);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(24, 144, 255, 0.3);
}

.btn-primary:active {
  opacity: 0.9;
}

.btn-wx {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3);
}

.btn-outline {
  background-color: #fff;
  border: 2rpx solid #1890FF;
  color: #1890FF;
}

.btn-block {
  width: 100%;
  margin: 0;
}

.btn-sm {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
}

/* 状态按钮 */
.btn-status {
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-resolved, .btn-returned {
  background-color: #52c41a;
  color: #fff;
}

.btn-cancel {
  background-color: #ff4d4f;
  color: #fff;
}

.btn-edit {
  background-color: #1890FF;
  color: #fff;
}

/* ================= 通用表单 ================= */
.form-section {
  background-color: #fff;
  padding: 30rpx;
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-icon {
  font-size: 36rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.form-item {
  margin-bottom: 30rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}

.form-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.input-label {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.required {
  color: #ff4d4f;
  font-size: 28rpx;
}

.optional {
  color: #999;
  font-size: 24rpx;
  font-weight: normal;
}

.input-field {
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  padding: 0 20rpx;
  background-color: #fafafa;
  border-radius: 8rpx;
}

.textarea-field {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  padding: 16rpx 20rpx;
  background-color: #fafafa;
  border-radius: 8rpx;
}

.picker-value {
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  padding: 0 20rpx;
  background-color: #fafafa;
  border-radius: 8rpx;
}

.counter {
  font-size: 22rpx;
  color: #bbb;
  position: absolute;
  right: 0;
  bottom: 28rpx;
}

/* ================= 通用列表 ================= */
.list-container {
  padding: 20rpx;
}

.list-item {
  background-color: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* ================= 通用文本 ================= */
.text-primary {
  color: #1890FF;
  font-weight: 500;
}

.text-success {
  color: #52c41a;
}

.text-warning {
  color: #faad14;
}

.text-danger {
  color: #ff4d4f;
}

.text-muted {
  color: #999;
}

.text-link {
  color: #1890FF;
}

.text-center {
  text-align: center;
}

/* ================= 间距 ================= */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.p-20 { padding: 20rpx; }

/* ================= 分隔线 ================= */
.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background-color: #e8e8e8;
}

.divider-text {
  padding: 0 20rpx;
  color: #ccc;
  font-size: 24rpx;
}

/* ================= 空状态 ================= */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
  margin-top: 12rpx;
}

/* ================= 加载中 ================= */
.loading-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.loading-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #e8e8e8;
  border-top-color: #1890FF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  color: #999;
}

/* ================= 状态标签 ================= */
.status-badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.status-ONGOING {
  color: #1890FF;
  background-color: #e6f7ff;
}

.status-RESOLVED {
  color: #52c41a;
  background-color: #f6ffed;
}

.status-RETURNED {
  color: #52c41a;
  background-color: #f6ffed;
}

.status-CANCELLED {
  color: #999;
  background-color: #f5f5f5;
}

.type-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  color: #fff;
  white-space: nowrap;
}

.type-LOST {
  background-color: #ff4d4f;
}

.type-FOUND {
  background-color: #52c41a;
}
