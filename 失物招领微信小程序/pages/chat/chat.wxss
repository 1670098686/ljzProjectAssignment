/* pages/chat/chat.wxss */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

.item-info {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #e8e8e8;
}

.item-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.item-avatar .item-img {
  width: 100%;
  height: 100%;
}

.item-content {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.item-title {
  font-size: 30rpx;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.arrow {
  font-size: 40rpx;
  color: #ccc;
  margin-left: 20rpx;
}

.message-list {
  flex: 1;
  padding: 20rpx;
}

.message-item {
  display: flex;
  margin-bottom: 30rpx;
}

.message-item.self {
  flex-direction: row-reverse;
}

.message-item.self .message-content {
  margin-right: 20rpx;
  margin-left: 0;
}

.message-item.self .text-bubble {
  background-color: #95ec69;
}

.message-item.other .message-content {
  margin-left: 20rpx;
}

.message-item.other .text-bubble {
  background-color: #fff;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  flex-shrink: 0;
}

.avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #e8e8e8;
  font-size: 40rpx;
}

.avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #1890FF;
  color: #fff;
  font-size: 34rpx;
  font-weight: 500;
}

.msg-nickname {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.message-content {
  max-width: 500rpx;
}

.text-bubble {
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 30rpx;
  word-wrap: break-word;
}

.image-bubble image {
  width: 300rpx;
  height: 300rpx;
  border-radius: 8rpx;
}

.input-bar {
  display: flex;
  padding: 20rpx;
  background-color: #fff;
  border-top: 1rpx solid #e8e8e8;
}

.input {
  flex: 1;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
}

.btn-image {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
}

.btn-image image {
  width: 50rpx;
  height: 50rpx;
}

.btn-send {
  margin-left: 20rpx;
  background-color: #1890FF;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 40rpx;
}
