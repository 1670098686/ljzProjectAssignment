/* pages/profile/my-items.wxss */
.my-items-container {
  min-height: 100vh;
  background-color: #f5f7fa;
}

.page-header {
  background: linear-gradient(135deg, #1890FF 0%, #096DD9 100%);
  padding: 40rpx 30rpx 30rpx;
  border-radius: 0 0 30rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.header-content {
  display: flex;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.filter-tabs {
  display: flex;
  background: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
  overflow-x: auto;
  white-space: nowrap;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex-shrink: 0;
  text-align: center;
  padding: 24rpx 20rpx;
  font-size: 24rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #1890FF;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #1890FF;
  border-radius: 2rpx;
}

.items-list {
  padding: 0 20rpx 20rpx;
}

.item-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.type-badge {
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.type-LOST {
  background: #fff1f0;
  color: #ff4d4f;
}

.type-FOUND {
  background: #f6ffed;
  color: #52c41a;
}

.audit-badge {
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.audit-badge.APPROVED {
  background: #f6ffed;
  color: #52c41a;
}

.audit-badge.PENDING {
  background: #fff7e6;
  color: #fa8c16;
}

.audit-badge.REJECTED {
  background: #fff1f0;
  color: #ff4d4f;
}

.item-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 16rpx;
}

.item-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-text {
  font-size: 24rpx;
  color: #999;
}

.empty-state {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.loading-state {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载更多 */
.loading-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx 0;
}

.loading-more-text {
  font-size: 26rpx;
  color: #999;
}

/* 无更多数据 */
.no-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx 0 60rpx;
}

.no-more-text {
  font-size: 26rpx;
  color: #ccc;
}
