&lt;!--pages/profile/my-items.wxml--&gt;
&lt;view class="my-items-container"&gt;
  &lt;view class="page-header"&gt;
    &lt;view class="header-content"&gt;
      &lt;text class="title"&gt;{{pageTitle}}&lt;/text&gt;
    &lt;/view&gt;
  &lt;/view&gt;

  &lt;view class="filter-tabs" wx:if="{{!loading}}"&gt;
    &lt;view class="tab-item {{currentStatus === 'all' ? 'active' : ''}}" bindtap="onSwitchTab" data-status="all"&gt;全部&lt;/view&gt;
    &lt;view class="tab-item {{currentStatus === 'PENDING' ? 'active' : ''}}" bindtap="onSwitchTab" data-status="PENDING"&gt;待审核&lt;/view&gt;
    &lt;view class="tab-item {{currentStatus === 'APPROVED' ? 'active' : ''}}" bindtap="onSwitchTab" data-status="APPROVED"&gt;已通过&lt;/view&gt;
    &lt;view class="tab-item {{currentStatus === 'REJECTED' ? 'active' : ''}}" bindtap="onSwitchTab" data-status="REJECTED"&gt;已驳回&lt;/view&gt;
  &lt;/view&gt;

  &lt;view class="items-list" wx:if="{{!loading}}"&gt;
    &lt;block wx:for="{{filteredItems}}" wx:key="id"&gt;
      &lt;view class="item-card" bindtap="goToDetail" data-id="{{item.id}}"&gt;
        &lt;view class="item-header"&gt;
          &lt;view class="type-badge type-{{item.itemType}}"&gt;
            &lt;text&gt;{{item.itemType === 'LOST' ? '🔍 寻物' : '📦 拾物'}}&lt;/text&gt;
          &lt;/view&gt;
          &lt;view class="audit-badge {{item.auditStatus}}"&gt;
            &lt;text&gt;{{item.auditStatus === 'APPROVED' ? '已通过' : item.auditStatus === 'PENDING' ? '待审核' : '已驳回'}}&lt;/text&gt;
          &lt;/view&gt;
        &lt;/view&gt;
        &lt;text class="item-title"&gt;{{item.title}}&lt;/text&gt;
        &lt;view class="item-info"&gt;
          &lt;text class="info-text"&gt;📍 {{item.location}}&lt;/text&gt;
          &lt;text class="info-text"&gt;🕒 {{item.happenTime || item.publishedAtText}}&lt;/text&gt;
        &lt;/view&gt;
        &lt;view class="biz-status" wx:if="{{item.bizStatusText}}"&gt;
          &lt;text&gt;状态：{{item.bizStatusText}}&lt;/text&gt;
        &lt;/view&gt;
      &lt;/view&gt;
    &lt;/block&gt;
    &lt;view class="empty-state" wx:if="{{filteredItems.length === 0}}"&gt;
      &lt;text class="empty-text"&gt;暂无相关内容&lt;/text&gt;
    &lt;/view&gt;
  &lt;/view&gt;

  &lt;!-- 加载更多 --&gt;
  &lt;view class="loading-more" wx:if="{{loadingMore}}"&gt;
    &lt;text class="loading-more-text"&gt;加载中...&lt;/text&gt;
  &lt;/view&gt;

  &lt;!-- 无更多数据 --&gt;
  &lt;view class="no-more" wx:if="{{noMoreData &amp;&amp; !loading &amp;&amp; !loadingMore}}"&gt;
    &lt;text class="no-more-text"&gt;已无更多数据&lt;/text&gt;
  &lt;/view&gt;

  &lt;view class="loading-state" wx:if="{{loading}}"&gt;
    &lt;text class="loading-text"&gt;加载中...&lt;/text&gt;
  &lt;/view&gt;
&lt;/view&gt;