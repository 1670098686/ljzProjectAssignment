&lt;!--pages/profile/profile.wxml--&gt;
&lt;view class="profile-container"&gt;
  &lt;!-- 用户信息头部 --&gt;
  &lt;view class="user-header" wx:if="{{isLoggedIn}}"&gt;
    &lt;view class="user-card"&gt;
      &lt;view class="user-avatar"&gt;
        &lt;text class="avatar-text"&gt;{{avatarChar}}&lt;/text&gt;
      &lt;/view&gt;
      &lt;view class="user-detail"&gt;
        &lt;view class="user-name-row"&gt;
          &lt;text class="nickname"&gt;{{userInfo.nickName || '未设置昵称'}}&lt;/text&gt;
          &lt;view class="role-badge" wx:if="{{isAdmin}}"&gt;管理员&lt;/view&gt;
        &lt;/view&gt;
        &lt;text class="email"&gt;{{userInfo.email || '未绑定邮箱'}}&lt;/text&gt;
      &lt;/view&gt;
      &lt;view class="logout-btn" bindtap="logout"&gt;
        &lt;text&gt;退出&lt;/text&gt;
      &lt;/view&gt;
    &lt;/view&gt;
  &lt;/view&gt;

  &lt;view class="user-header user-header-unlogged" wx:else bindtap="goToLogin"&gt;
    &lt;view class="user-card"&gt;
      &lt;view class="user-avatar unlogged-avatar"&gt;
        &lt;text class="avatar-text"&gt;?&lt;/text&gt;
      &lt;/view&gt;
      &lt;view class="user-detail"&gt;
        &lt;text class="nickname"&gt;点击登录&lt;/text&gt;
        &lt;text class="email"&gt;登录后使用更多功能&lt;/text&gt;
      &lt;/view&gt;
      &lt;text class="login-arrow"&gt;›&lt;/text&gt;
    &lt;/view&gt;
  &lt;/view&gt;

  &lt;!-- 统计卡片 --&gt;
  &lt;view class="stats-cards" wx:if="{{isLoggedIn}}"&gt;
    &lt;view class="stat-card" hover-class="stat-card-hover" bindtap="goToMyItems" data-status="all"&gt;
      &lt;text class="stat-value"&gt;{{myItems.length}}&lt;/text&gt;
      &lt;text class="stat-label"&gt;发布数&lt;/text&gt;
    &lt;/view&gt;
    &lt;view class="stat-card" hover-class="stat-card-hover" bindtap="goToMyItems" data-status="APPROVED"&gt;
      &lt;text class="stat-value"&gt;{{approvedCount}}&lt;/text&gt;
      &lt;text class="stat-label"&gt;已通过&lt;/text&gt;
    &lt;/view&gt;
    &lt;view class="stat-card" hover-class="stat-card-hover" bindtap="goToMyItems" data-status="PENDING"&gt;
      &lt;text class="stat-value"&gt;{{pendingCount}}&lt;/text&gt;
      &lt;text class="stat-label"&gt;待审核&lt;/text&gt;
    &lt;/view&gt;
  &lt;/view&gt;

  &lt;!-- 我的发布 --&gt;
  &lt;view class="content-section" wx:if="{{isLoggedIn &amp;&amp; myItems.length &gt; 0}}"&gt;
    &lt;view class="section-header"&gt;
      &lt;text class="section-title"&gt;最近发布&lt;/text&gt;
    &lt;/view&gt;
    &lt;view class="my-items"&gt;
      &lt;block wx:for="{{myItems}}" wx:key="id" wx:if="{{index &lt; 3}}"&gt;
        &lt;view class="my-item" bindtap="goToMyItemDetail" data-id="{{item.id}}"&gt;
          &lt;view class="item-info"&gt;
            &lt;text class="my-item-title"&gt;{{item.title}}&lt;/text&gt;
            &lt;text class="my-item-time"&gt;{{item.publishedAtText || '刚刚'}}&lt;/text&gt;
          &lt;/view&gt;
          &lt;view class="item-status {{item.bizStatus}}"&gt;
            {{item.statusText}}
          &lt;/view&gt;
        &lt;/view&gt;
      &lt;/block&gt;
    &lt;/view&gt;
  &lt;/view&gt;

  &lt;!-- 管理员后台入口 --&gt;
  &lt;view class="admin-section" wx:if="{{isAdmin}}"&gt;
    &lt;view class="admin-title"&gt;
      &lt;text&gt;管理员后台&lt;/text&gt;
    &lt;/view&gt;
    &lt;view class="admin-menu"&gt;
      &lt;view class="admin-item" bindtap="goToAdminAudit"&gt;
        &lt;text&gt;审核管理&lt;/text&gt;
        &lt;text class="arrow"&gt;›&lt;/text&gt;
      &lt;/view&gt;
      &lt;view class="admin-item" bindtap="goToAdminReports"&gt;
        &lt;text&gt;举报处理&lt;/text&gt;
        &lt;text class="arrow"&gt;›&lt;/text&gt;
      &lt;/view&gt;
      &lt;view class="admin-item" bindtap="goToAdminStatistics"&gt;
        &lt;text&gt;数据统计&lt;/text&gt;
        &lt;text class="arrow"&gt;›&lt;/text&gt;
      &lt;/view&gt;
    &lt;/view&gt;
  &lt;/view&gt;

  &lt;!-- 其他功能 --&gt;
  &lt;view class="menu-section" wx:if="{{isLoggedIn}}"&gt;
    &lt;view class="menu-card"&gt;
      &lt;view class="menu-item" bindtap="goToAbout"&gt;
        &lt;text class="menu-text"&gt;关于我们&lt;/text&gt;
        &lt;text class="menu-arrow"&gt;›&lt;/text&gt;
      &lt;/view&gt;
      &lt;view class="menu-item" bindtap="goToHelp"&gt;
        &lt;text class="menu-text"&gt;帮助中心&lt;/text&gt;
        &lt;text class="menu-arrow"&gt;›&lt;/text&gt;
      &lt;/view&gt;
    &lt;/view&gt;
  &lt;/view&gt;

  &lt;!-- 底部留白 --&gt;
  &lt;view class="bottom-space"&gt;&lt;/view&gt;
&lt;/view&gt;