// pages/profile/profile.js
const { get } = require('../../utils/request');
const { requireLogin, getUserInfo, clearLogin } = require('../../utils/auth');
const { showToast, showConfirm, formatRelativeTime, getBizStatusText } = require('../../utils/util');

Page({
  data: {
    isLoggedIn: false,
    userInfo: null,
    isAdmin: false,
    myItems: [],
    myItemsLoading: false,
    approvedCount: 0,
    pendingCount: 0,
    avatarChar: '用'
  },

  onShow() {
    this.loadUserInfo();
  },

  loadUserInfo() {
    const user = getUserInfo();
    if (user) {
      let avatarCharVal = '用';
      if (user.nickName) {
        avatarCharVal = user.nickName.charAt(0);
      }
      this.setData({
        isLoggedIn: true,
        userInfo: user,
        isAdmin: user.role === 'ADMIN',
        avatarChar: avatarCharVal
      });
      this.loadMyItems();
    } else {
      this.setData({
        isLoggedIn: false,
        userInfo: null
      });
    }
  },

  loadMyItems() {
    this.setData({ myItemsLoading: true });
    get('/auth/me/items')
      .then(res => {
        const list = res.data.list || [];
        const items = [];
        for (let i = 0; i < list.length; i++) {
          const item = list[i];
          items.push({
            id: item.id,
            title: item.title,
            itemType: item.itemType,
            auditStatus: item.auditStatus,
            bizStatus: item.bizStatus,
            publishedAt: item.publishedAt,
            publishedAtText: formatRelativeTime(item.publishedAt),
            statusText: getBizStatusText(item.bizStatus, item.itemType)
          });
        }
        
        let approvedCount = 0;
        let pendingCount = 0;
        for (let j = 0; j < items.length; j++) {
          if (items[j].auditStatus === 'APPROVED') {
            approvedCount++;
          } else if (items[j].auditStatus === 'PENDING') {
            pendingCount++;
          }
        }
        this.setData({
          myItems: items,
          approvedCount: approvedCount,
          pendingCount: pendingCount
        });
      })
      .catch(err => {
        console.error('加载我的发布失败:', err);
      })
      .finally(() => {
        this.setData({ myItemsLoading: false });
      });
  },

  goToLogin() {
    wx.navigateTo({
      url: '/pages/login/login'
    });
  },

  logout() {
    showConfirm('退出登录', '确定要退出登录吗？')
      .then(confirm => {
        if (confirm) {
          clearLogin();
          this.setData({
            isLoggedIn: false,
            userInfo: null,
            isAdmin: false,
            myItems: []
          });
          showToast('已退出登录', 'success');
          
          setTimeout(() => {
            wx.reLaunch({
              url: '/pages/login/login'
            });
          }, 1000);
        }
      });
  },

  goToMyItems(e) {
    const status = e.currentTarget.dataset.status;
    wx.navigateTo({
      url: '/pages/profile/my-items?status=' + status
    });
  },

  goToPublish() {
    wx.switchTab({
      url: '/pages/publish/publish'
    });
  },

  goToAbout() {
    showToast('功能开发中');
  },

  goToHelp() {
    showToast('功能开发中');
  },

  goToAdminAudit() {
    wx.navigateTo({
      url: '/pages/admin/audit-list'
    });
  },

  goToAdminReports() {
    wx.navigateTo({
      url: '/pages/admin/report-list'
    });
  },

  goToAdminStatistics() {
    wx.navigateTo({
      url: '/pages/admin/statistics'
    });
  },

  goToMyItemDetail(e) {
    const id = e.currentTarget.dataset.id;
    wx.navigateTo({
      url: '/pages/detail/detail?id=' + id
    });
  }
});
