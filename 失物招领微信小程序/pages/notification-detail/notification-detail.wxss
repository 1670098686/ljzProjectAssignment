
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.notification-detail {
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.detail-header {
  display: flex;
  align-items: flex-start;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  gap: 20rpx;
}

.detail-icon {
  font-size: 60rpx;
  flex-shrink: 0;
}

.detail-header-info {
  flex: 1;
}

.detail-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.detail-time {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.detail-content {
  padding: 30rpx;
}

.detail-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  display: block;
  word-wrap: break-word;
  word-break: break-word;
  white-space: pre-wrap;
}

.detail-related {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
  background-color: #fafafa;
}

.detail-related text:first-child {
  font-size: 28rpx;
  color: #1890FF;
}

.detail-related .arrow {
  font-size: 36rpx;
  color: #ccc;
}

