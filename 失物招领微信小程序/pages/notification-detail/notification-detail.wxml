<view class="container">
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:if="{{!loading && notification}}" class="notification-detail">
    <view class="detail-header">
      <text class="detail-icon">{{getNotificationIcon(notification.type)}}</text>
      <view class="detail-header-info">
        <text class="detail-title">{{notification.title}}</text>
        <text class="detail-time">{{notification.timeText}}</text>
      </view>
    </view>

    <view class="detail-content">
      <text class="detail-text">{{notification.content}}</text>
    </view>

    <view wx:if="{{notification.relatedId}}" class="detail-related" bindtap="goToRelated">
      <text>查看相关信息</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
