/* pages/admin/statistics.wxss */
.statistics-container {
  min-height: 100vh;
  background-color: #f5f7fa;
}

.page-header {
  background: linear-gradient(135deg, #1890FF 0%, #096DD9 100%);
  padding: 40rpx 30rpx 30rpx;
  border-radius: 0 0 30rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.header-content {
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stats-section {
  padding: 24rpx;
}

.section-title {
  padding: 16rpx 0;
}

.title-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.stat-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  position: relative;
}

.stat-card-hover {
  background: #f0f7ff;
  transform: scale(0.96);
}

.stat-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.stat-icon::before {
  font-size: 24rpx;
  font-weight: bold;
}

.stat-icon-total {
  background: #e6f7ff;
}

.stat-icon-total::before {
  content: "📊";
}

.stat-icon-lost {
  background: #fff1f0;
}

.stat-icon-lost::before {
  content: "🔍";
}

.stat-icon-found {
  background: #f6ffed;
}

.stat-icon-found::before {
  content: "📦";
}

.stat-icon-approved {
  background: #e6fffb;
}

.stat-icon-approved::before {
  content: "✓";
}

.stat-icon-resolved {
  background: #f9f0ff;
}

.stat-icon-resolved::before {
  content: "🎯";
}

.stat-icon-report {
  background: #fff7e6;
}

.stat-icon-report::before {
  content: "⚠";
}

.stat-content {
  display: flex;
  flex-direction: column;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #333;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.trend-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.trend-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.trend-item:last-child {
  border-bottom: none;
}

.trend-label {
  font-size: 28rpx;
  color: #666;
}

.trend-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.trend-value.trend-up {
  color: #52c41a;
}

.trend-arrow {
  font-size: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  width: 100rpx;
  height: 100rpx;
  background: #e6f7ff;
  border-radius: 50%;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
}
