/* pages/admin/stat-detail.wxss */
.stat-detail-container {
  min-height: 100vh;
  background-color: #f5f7fa;
}

.page-header {
  background: linear-gradient(135deg, #1890FF 0%, #096DD9 100%);
  padding: 40rpx 30rpx 30rpx;
  border-radius: 0 0 30rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.header-content {
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.content {
  padding: 24rpx;
}

.overview-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.overview-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.overview-value {
  font-size: 64rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 8rpx;
}

.overview-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  margin-bottom: 20rpx;
}

.title-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.trend-chart {
  margin-top: 16rpx;
}

.chart-container {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 240rpx;
  padding: 20rpx 0;
}

.chart-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.chart-bar {
  width: 36rpx;
  background: linear-gradient(180deg, #1890FF 0%, #69c0ff 100%);
  border-radius: 8rpx 8rpx 0 0;
  margin-bottom: 12rpx;
  min-height: 20rpx;
  transition: height 0.3s ease;
}

.chart-label {
  font-size: 22rpx;
  color: #999;
}

.detail-list {
  margin-top: 8rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-item:last-child {
  border-bottom: none;
}

.item-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.item-type {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  width: fit-content;
}

.item-type.lost {
  background: #fff1f0;
  color: #ff4d4f;
}

.item-type.found {
  background: #f6ffed;
  color: #52c41a;
}

.item-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-time {
  font-size: 22rpx;
  color: #999;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.item-status.approved {
  background: #f6ffed;
  color: #52c41a;
}

.item-status.pending {
  background: #fff7e6;
  color: #fa8c16;
}

.item-status.rejected {
  background: #fff1f0;
  color: #ff4d4f;
}

.item-arrow {
  font-size: 28rpx;
  color: #ccc;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.loading-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  animation: rotate 1s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}