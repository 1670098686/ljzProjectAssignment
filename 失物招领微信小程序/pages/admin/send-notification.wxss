/* pages/admin/send-notification.wxss */
.send-notification-container {
  padding: 20rpx;
  background-color: #f5f7fa;
  min-height: 100vh;
}

.form-section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

.input-field {
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  color: #333333;
  background-color: #f5f7fa;
  border-radius: 8rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.textarea-field {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #333333;
  background-color: #f5f7fa;
  border-radius: 8rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.char-count {
  font-size: 24rpx;
  color: #999999;
  margin-top: 10rpx;
  display: block;
  text-align: right;
}

.radio-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.radio-item {
  display: flex;
  align-items: center;
}

.radio-label {
  display: flex;
  align-items: center;
}

.radio-text {
  font-size: 28rpx;
  color: #333333;
  margin-left: 10rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  margin-top: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn[disabled] {
  opacity: 0.6;
}
