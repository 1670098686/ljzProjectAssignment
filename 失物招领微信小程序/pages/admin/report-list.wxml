<view class="report-container">
  <view class="page-header">
    <view class="header-content">
      <text class="title">举报处理</text>
      <view class="count-badge">
        <text class="count-text">{{reports.length}}</text>
      </view>
    </view>
  </view>

  <view class="report-list" wx:if="{{reports.length > 0}}">
    <block wx:for="{{reports}}" wx:key="id">
      <view class="report-card">
        <view class="card-header">
          <view class="type-badge">
            <text>⚠️ {{item.reasonType}}</text>
          </view>
          <view class="status-tag {{item.status === 'PENDING' ? 'pending' : 'handled'}}">
            <text>{{item.status === 'PENDING' ? '待处理' : '已处理'}}</text>
          </view>
        </view>
        
        <view class="item-title">
          <text>{{item.itemTitle || '未知物品'}}</text>
        </view>

        <view class="card-info">
          <view class="info-row">
            <text class="info-icon">👤</text>
            <text class="info-text">举报人：{{item.reporterName || '匿名用户'}}</text>
          </view>
          <view class="info-row">
            <text class="info-icon">🕒</text>
            <text class="info-text">{{item.createdAt}}</text>
          </view>
        </view>

        <view class="card-divider"></view>

        <view class="reason-section">
          <view class="reason-type-row">
            <text class="reason-label">举报类型</text>
            <text class="reason-type">{{item.reasonType}}</text>
          </view>
          <view class="reason-detail-row" wx:if="{{item.reasonDetail}}">
            <text class="reason-label">补充说明</text>
            <text class="reason-text">{{item.reasonDetail}}</text>
          </view>
        </view>

        <view class="result-section" wx:if="{{item.status !== 'PENDING' && item.handleResult}}">
          <text class="result-label">📝 处理备注</text>
          <text class="result-text">{{item.handleResult}}</text>
        </view>

        <view class="card-actions" wx:if="{{item.status === 'PENDING'}}">
          <button class="action-btn btn-handle" bindtap="onHandle" data-id="{{item.id}}">
            <text class="btn-icon">✓</text>
            <text>标记处理</text>
          </button>
          <button class="action-btn btn-view" bindtap="goToItem" data-id="{{item.itemId}}">
            <text class="btn-icon">👁</text>
            <text>查看物品</text>
          </button>
        </view>
      </view>
    </block>
  </view>

  <view class="empty-state" wx:else>
    <view class="empty-icon">👏</view>
    <text class="empty-text">暂无举报记录</text>
    <text class="empty-desc">平台环境一片祥和</text>
  </view>

  <view wx:if="{{showHandleModal}}" class="modal-mask" catchtouchmove="return">
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">{{actionType === 'REMOVE' ? '下架物品' : '忽略举报'}}</text>
      </view>
      <view class="modal-body">
        <view class="modal-item-info">
          <text class="modal-label">物品名称</text>
          <text class="modal-value">{{currentReport.itemTitle || '未知物品'}}</text>
        </view>
        <view class="modal-note-section">
          <text class="modal-label">处理备注<text class="note-hint">（将作为系统通知反馈给用户）</text></text>
          <textarea
            class="modal-textarea"
            value="{{noteContent}}"
            bindinput="onNoteInput"
            placeholder="{{actionType === 'REMOVE' ? '请填写下架原因，将反馈给物品发布者和举报人...' : '请填写忽略原因，将反馈给举报人...'}}"
            maxlength="200"
            auto-height
          ></textarea>
        </view>
      </view>
      <view class="modal-footer">
        <button class="modal-btn modal-btn-cancel" bindtap="onCancelModal" disabled="{{modalLoading}}">取消</button>
        <button class="modal-btn modal-btn-confirm" bindtap="onConfirmHandle" disabled="{{modalLoading}}">
          {{modalLoading ? '处理中...' : '确认处理'}}
        </button>
      </view>
    </view>
  </view>
</view>
