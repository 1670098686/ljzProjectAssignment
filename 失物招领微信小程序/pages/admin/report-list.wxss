/* pages/admin/report-list.wxss */
.report-container {
  min-height: 100vh;
  background-color: #f5f7fa;
}

.page-header {
  background: linear-gradient(135deg, #1890FF 0%, #096DD9 100%);
  padding: 40rpx 30rpx 30rpx;
  border-radius: 0 0 30rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.header-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.count-badge {
  background: rgba(255, 255, 255, 0.25);
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
  min-width: 48rpx;
  text-align: center;
}

.count-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
}

.report-list {
  padding: 24rpx 24rpx 40rpx;
}

.report-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.type-badge {
  background: #fff7e6;
  color: #fa8c16;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.status-tag {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.status-tag.pending {
  background: #fff1f0;
  color: #ff4d4f;
}

.status-tag.handled {
  background: #f6ffed;
  color: #52c41a;
}

.item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  display: block;
}

.card-info {
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.info-text {
  font-size: 26rpx;
  color: #666;
}

.card-divider {
  height: 1rpx;
  background: #f0f0f0;
  margin-bottom: 20rpx;
}

.reason-section {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.reason-type-row,
.reason-detail-row {
  margin-bottom: 16rpx;
}

.reason-type-row:last-child,
.reason-detail-row:last-child {
  margin-bottom: 0;
}

.reason-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.reason-type {
  font-size: 28rpx;
  color: #1890FF;
  font-weight: 500;
  display: block;
}

.reason-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  display: block;
}

.result-section {
  background: #fff7e6;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-left: 4rpx solid #fa8c16;
}

.result-label {
  font-size: 24rpx;
  color: #fa8c16;
  display: block;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.result-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  display: block;
}

.card-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: none;
  padding: 0;
  line-height: 1;
}

.action-btn::after {
  border: none;
}

.btn-icon {
  font-size: 24rpx;
}

.btn-handle {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  color: #fff;
}

.btn-view {
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  color: #fff;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 86%;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-header {
  padding: 40rpx 30rpx 20rpx;
  text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.modal-body {
  padding: 30rpx;
}

.modal-item-info {
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.modal-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.note-hint {
  font-size: 22rpx;
  color: #bbb;
  font-weight: normal;
}

.modal-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.modal-note-section {
  margin-bottom: 20rpx;
}

.modal-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  line-height: 1.5;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  height: 100rpx;
  border: none;
  font-size: 30rpx;
  background: #fff;
  border-radius: 0;
}

.modal-btn::after {
  border: none;
}

.modal-btn-cancel {
  color: #999;
  border-right: 1rpx solid #f0f0f0;
}

.modal-btn-confirm {
  color: #1890ff;
  font-weight: 500;
}

.modal-btn[disabled] {
  opacity: 0.5;
}
