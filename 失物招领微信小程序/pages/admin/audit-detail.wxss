/* pages/admin/audit-detail.wxss */
.detail-container {
  min-height: 100vh;
  background-color: #f5f7fa;
}

.page-header {
  background: linear-gradient(135deg, #1890FF 0%, #096DD9 100%);
  padding: 40rpx 30rpx 30rpx;
  border-radius: 0 0 30rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.header-content {
  display: flex;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.detail-content {
  padding: 24rpx;
}

.item-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.type-badge {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.type-LOST {
  background: #fff1f0;
  color: #ff4d4f;
}

.type-FOUND {
  background: #f6ffed;
  color: #52c41a;
}

.audit-status {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.audit-status.PENDING {
  background: #fff7e6;
  color: #fa8c16;
}

.audit-status.APPROVED {
  background: #f6ffed;
  color: #52c41a;
}

.audit-status.REJECTED {
  background: #fff1f0;
  color: #ff4d4f;
}

.item-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 24rpx;
  display: block;
}

.item-info-section {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
}

.item-divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 24rpx 0;
}

.description-section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.description-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  display: block;
}

.images-section {
  margin-bottom: 8rpx;
}

.images-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.item-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
}

.action-section {
  display: flex;
  gap: 16rpx;
  padding-top: 8rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: none;
  padding: 0;
  line-height: 1;
}

.action-btn::after {
  border: none;
}

.btn-icon {
  font-size: 24rpx;
}

.btn-approve {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  color: #fff;
}

.btn-reject {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  color: #fff;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
