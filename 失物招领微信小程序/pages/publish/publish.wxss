/* pages/publish/publish.wxss */
.publish-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

/* 顶部类型切换 */
.type-tabs {
  display: flex;
  background-color: #fff;
  padding: 0 40rpx;
}

.type-tabs .tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 32rpx;
  color: #666;
  position: relative;
  font-weight: 400;
}

.type-tabs .tab-item.active {
  color: #1890FF;
  font-weight: 600;
}

.type-tabs .tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #1890FF;
  border-radius: 3rpx;
}

/* 滚动内容 */
.scroll-content {
  flex: 1;
  height: 0;
}

/* 表单提示 */
.form-hint {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

/* 分类选择器 */
.picker {
  display: flex;
  gap: 12rpx;
  margin-top: 10rpx;
}

.textarea-item {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

/* 图片上传 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  background-color: #fafafa;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 60rpx;
  color: #ccc;
}

.add-text {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 10rpx;
}

.upload-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-error {
  background-color: rgba(255, 77, 79, 0.5);
}

.upload-text {
  font-size: 24rpx;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 发布提示 */
.publish-tip {
  margin: 0 20rpx 30rpx;
  padding: 24rpx;
  background-color: #fffbe6;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tip-icon {
  font-size: 32rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #8c8c8c;
}

/* 底部发布按钮 */
.bottom-bar {
  background-color: #fff;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}
