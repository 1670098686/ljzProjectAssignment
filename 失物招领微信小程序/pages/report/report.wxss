.report-container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: #F5F5F5;
}

.page-header {
  padding: 20rpx 0 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.item-info {
  background-color: #FFF;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.item-label {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-bottom: 16rpx;
}

.item-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.reason-section,
.detail-section {
  background-color: #FFF;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 24rpx;
}

.reason-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.reason-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.reason-label {
  font-size: 30rpx;
  color: #333;
  margin-left: 16rpx;
}

.detail-input {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background-color: #F9F9F9;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.submit-section {
  padding: 40rpx 0;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF4D4F 0%, #F5222D 100%);
  color: #FFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn.disabled {
  opacity: 0.6;
}
