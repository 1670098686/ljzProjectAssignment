/* pages/register/register.wxss */
page {
  background-color: #f5f7fa;
}

.register-container {
  min-height: 100vh;
  padding: 32rpx;
}

.register-form {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 40rpx;
}

/* 区块标签 */
.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  padding-left: 8rpx;
}

/* 身份选择 */
.role-selector {
  display: flex;
  gap: 16rpx;
  background-color: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
}

.role-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  background-color: #fafafa;
}

.role-item.active {
  border-color: #1890FF;
  background-color: #e6f7ff;
}

.role-name {
  font-size: 26rpx;
  color: #666;
}

.role-item.active .role-name {
  color: #1890FF;
  font-weight: 500;
}

/* 表单卡片 */
.form-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 0 32rpx;
  border: 2rpx solid #e8e8e8;
}

.form-group {
  padding: 28rpx 0;
}

.form-divider {
  height: 1rpx;
  background-color: #eee;
  margin-left: 0;
}

.field-label-row {
  margin-bottom: 16rpx;
}

.field-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.required-mark {
  color: #ff4d4f;
  font-size: 28rpx;
  margin-left: 4rpx;
}

.input-field {
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  padding: 0 16rpx;
  background-color: #f5f7fa;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  box-sizing: border-box;
}

/* 验证码输入框包装器 */
.code-input-wrapper {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.code-input {
  flex: 6;
}

.btn-send-code {
  flex: 4;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background-color: #1890FF;
  color: #fff;
  border-radius: 12rpx;
  font-size: 24rpx;
  border: none;
  padding: 0;
}

.btn-send-code.disabled {
  background: #d9d9d9;
  color: #999;
}

/* 密码提示 */
.form-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  padding-left: 8rpx;
  display: block;
}

/* 注册按钮 */
.btn-register {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 46rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1890FF 0%, #096dd9 100%);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(24, 144, 255, 0.3);
  margin: 16rpx 0;
}

/* 底部登录入口 */
.go-login {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  padding-bottom: 40rpx;
}

.text-muted {
  color: #999;
}

.text-primary {
  color: #1890FF;
  font-weight: 500;
}
