/* pages/login/login.wxss */
page {
  background-color: #f8f9fc;
}

.login-container {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.bg-circle {
  position: absolute;
  border-radius: 50%;
}

.bg-circle-1 {
  width: 360rpx;
  height: 360rpx;
  background: linear-gradient(135deg, rgba(24, 144, 255, 0.08) 0%, rgba(24, 144, 255, 0.04) 100%);
  top: -80rpx;
  right: -100rpx;
}

.bg-circle-2 {
  width: 240rpx;
  height: 240rpx;
  background: linear-gradient(135deg, rgba(7, 193, 96, 0.06) 0%, rgba(7, 193, 96, 0.03) 100%);
  bottom: 300rpx;
  left: -80rpx;
}

/* 头部区域 */
.header {
  padding: 120rpx 60rpx 60rpx;
  display: flex;
  justify-content: center;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-circle {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1890FF 0%, #096dd9 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(24, 144, 255, 0.25);
}

.logo-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.app-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.app-desc {
  font-size: 26rpx;
  color: #999;
  letter-spacing: 2rpx;
}

/* 登录卡片 */
.login-card {
  background-color: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 0 48rpx 60rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
}

/* 登录模式切换 */
.tab-bar {
  display: flex;
  background-color: #f5f7fa;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 40rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.tab-item.active {
  background-color: #fff;
  color: #1890FF;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 登录内容区 */
.login-content {
  display: flex;
  flex-direction: column;
}

.welcome-text {
  font-size: 30rpx;
  color: #333;
  text-align: center;
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.input-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

/* 协议 */
.agreement {
  text-align: center;
  margin-top: 24rpx;
  font-size: 22rpx;
}

.extra-links {
  text-align: center;
  margin-top: 20rpx;
  font-size: 26rpx;
}

/* 分隔线 */
.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background-color: #eee;
}

.divider-text {
  padding: 0 24rpx;
  color: #ccc;
  font-size: 24rpx;
}

/* 注册入口 */
.go-register {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
}
