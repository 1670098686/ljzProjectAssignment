/* pages/message/message.wxss */
.message-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}

/* 顶部标签切换 */
.tab-bar {
  display: flex;
  background-color: #fff;
  padding: 0 40rpx;
}

.tab-bar .tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
}

.tab-bar .tab-item.active {
  color: #1890FF;
  font-weight: 600;
}

.tab-bar .tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #1890FF;
  border-radius: 3rpx;
}

.tab-bar .tab-item .tab-badge {
  position: absolute;
  top: 16rpx;
  right: 30rpx;
  background-color: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
}

/* 滚动区域 */
.scroll-view {
  flex: 1;
  height: 0;
}

/* 系统消息列表 */
.notification-list {
  padding: 20rpx;
}

.notification-item {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  position: relative;
}

.notification-item.read {
  opacity: 0.7;
}

.notification-item.unread {
  background-color: #f0f7ff;
}

.notification-icon {
  font-size: 40rpx;
  flex-shrink: 0;
  margin-top: 6rpx;
}

.notification-content {
  flex: 1;
}

.notification-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.notification-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  line-height: 1.5;
  display: block;
  word-wrap: break-word;
  word-break: break-word;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.notification-time {
  font-size: 22rpx;
  color: #bbb;
  display: block;
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #ff4d4f;
  border-radius: 50%;
  position: absolute;
  top: 30rpx;
  right: 30rpx;
}

/* 会话列表 */
.conversation-list {
  padding: 20rpx;
}

.conversation-item {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.conversation-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background-color: #e8e8e8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.conversation-avatar .avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.conversation-avatar-text {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background-color: #1890FF;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.conversation-info {
  flex: 1;
  min-width: 0;
}

.item-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-desc {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.conversation-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.conversation-time {
  font-size: 22rpx;
  color: #ccc;
}

.unread-badge {
  background-color: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  min-width: 36rpx;
  text-align: center;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
}

/* 加载更多 */
.loading-more {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* 没有更多数据 */
.no-more-data {
  text-align: center;
  padding: 30rpx 0;
  color: #ccc;
  font-size: 24rpx;
}
