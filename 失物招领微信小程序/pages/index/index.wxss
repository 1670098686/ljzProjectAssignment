/* pages/index/index.wxss */
.index-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

/* 顶部标签页 */
.top-tabs {
  display: flex;
  background-color: #fff;
  padding: 0 40rpx;
}

.top-tabs .tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 32rpx;
  color: #666;
  position: relative;
  font-weight: 400;
}

.top-tabs .tab-item.active {
  color: #1890FF;
  font-weight: 600;
}

.top-tabs .tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #1890FF;
  border-radius: 3rpx;
}

/* 搜索栏 */
.search-bar {
  background-color: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.search-input-wrapper {
  flex: 1;
  height: 64rpx;
  background-color: #f5f5f5;
  border-radius: 32rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
}

.clear-btn {
  font-size: 32rpx;
  color: #999;
  padding: 0 8rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-btn {
  font-size: 28rpx;
  color: #1890FF;
  white-space: nowrap;
}

/* 筛选区 */
.filter-bar {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 20rpx 30rpx;
  gap: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.filter-item {
  padding: 12rpx 28rpx;
  font-size: 28rpx;
  color: #333;
  border-radius: 20rpx;
  background-color: #f5f7fa;
}

/* 筛选弹窗通用样式 */
.filter-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-modal-content {
  width: 85%;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx 60rpx;
}

.filter-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 40rpx;
  text-align: center;
}

/* 类型筛选选项 */
.filter-options {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 40rpx;
  gap: 16rpx;
}

.filter-option {
  width: calc(33.333% - 11rpx);
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 16rpx;
  border: 2rpx solid #e8e8e8;
  background-color: #fff;
  text-align: center;
  box-sizing: border-box;
}

.filter-option.active {
  color: #1890FF;
  border-color: #1890FF;
  background-color: #e6f7ff;
}

/* 地点筛选选项 */
.location-options .filter-option {
  width: calc(33.333% - 11rpx);
}

.location-options .filter-option:last-child {
  width: calc(33.333% - 11rpx);
}

/* 时间选项 */
.time-options {
  display: flex;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.time-option {
  flex: 1;
  margin: 0 10rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 16rpx;
  border: 2rpx solid #e8e8e8;
  background-color: #fff;
  text-align: center;
}

.time-option:first-child {
  margin-left: 0;
}

.time-option:last-child {
  margin-right: 0;
}

.time-option.active {
  color: #1890FF;
  border-color: #1890FF;
  background-color: #e6f7ff;
}

/* 确定按钮 */
.filter-actions {
  display: flex;
  justify-content: center;
}

.btn-filter-confirm {
  width: 480rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background-color: #1890FF;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  padding: 0;
}

/* 滚动区域 */
.scroll-view {
  flex: 1;
  height: 0;
}

/* 列表 */
.list-container {
  padding: 20rpx 30rpx;
  min-height: 100%;
}

.item-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.item-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.item-image-placeholder {
  background: linear-gradient(135deg, #f0f0f0 0%, #e8e8e8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-text {
  font-size: 48rpx;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.item-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  gap: 10rpx;
}

.item-type-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  color: #fff;
  white-space: nowrap;
}

.item-details {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.item-detail-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.detail-icon {
  font-size: 24rpx;
}

.item-location, .item-time {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.item-published {
  font-size: 22rpx;
  color: #bbb;
}

/* 加载更多 */
.loading-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.loading-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #e8e8e8;
  border-top-color: #1890FF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 没有更多了 */
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  gap: 16rpx;
}

.no-more::before,
.no-more::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background-color: #e8e8e8;
}

.no-more text {
  font-size: 24rpx;
  color: #bbb;
  white-space: nowrap;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
  margin-top: 12rpx;
}
