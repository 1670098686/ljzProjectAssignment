<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 工具栏 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="支付功能测试"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 说明卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="支付功能测试说明"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="本页面用于测试支付功能模块，点击下方测试按钮可以体验完整的支付流程。\n\n• 支付功能为模拟实现，无需真实支付\n• 确认支付后订单将立即完成\n• 支付完成后会跳转到支付成功页面\n• 支持查看支付详情和订单信息"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 测试按钮区域 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="测试用例"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="12dp" />

                    <!-- 测试按钮1 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestPayment1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="测试支付 - 二手iPhone 13"
                        android:textSize="14sp"
                        style="@style/Widget.Material3.Button.OutlinedButton" />

                    <!-- 测试按钮2 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestPayment2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="测试支付 - Java编程思想"
                        android:textSize="14sp"
                        style="@style/Widget.Material3.Button.OutlinedButton" />

                    <!-- 测试按钮3 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestPayment3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="测试支付 - 笔记本电脑"
                        android:textSize="14sp"
                        style="@style/Widget.Material3.Button.OutlinedButton" />

                    <!-- 测试按钮4 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestPayment4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="测试支付 - 运动鞋"
                        android:textSize="14sp"
                        style="@style/Widget.Material3.Button.OutlinedButton" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 功能说明 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="已实现的功能"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✅ 支付数据模型（PaymentData.kt）\n✅ 支付数据访问层（PaymentRepository.kt）\n✅ 支付ViewModel（PaymentViewModel.kt）\n✅ 支付页面布局（activity_payment.xml）\n✅ 支付Activity（PaymentActivity.kt）\n✅ 支付成功页面布局（activity_payment_success.xml）\n✅ 支付成功Activity（PaymentSuccessActivity.kt）\n✅ AndroidManifest注册"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

</LinearLayout>