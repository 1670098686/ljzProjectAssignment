# ============ 千问 LLM 配置 ============
# 前往 https://dashscope.console.aliyun.com/ 获取 API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 模型名称: qwen-max (千问Max), qwen-plus (千问Plus), qwen-turbo (千问Turbo)
# 注: "千问3.8 Max" 实际对应 DashScope 的 qwen-max
MODEL_NAME=qwen-max
TEMPERATURE=0.7

# ============ 后端业务 API 配置 ============
# Spring Boot 后端地址（本地开发或 Docker 网络）
BACKEND_BASE_URL=http://localhost:8080

# ============ AI Agent 服务配置 ============
AI_SERVICE_PORT=8081
AI_SERVICE_HOST=0.0.0.0

# ============ 会话记忆（生产环境可启用 Redis） ============
# REDIS_URL=redis://localhost:6379/0

# ============ 日志级别 ============
LOG_LEVEL=INFO
